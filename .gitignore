# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data based configurations, which should be kept separate
# from the code.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore plan files
*.tfplan
tfplan

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Azure Functions
functions/**/local.settings.json
functions/**/.python_packages/
functions/**/bin/
functions/**/obj/
.build/

# =========================
# Python specific
# =========================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# =========================
# OS / Editor specific
# =========================
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db
